* =============================================================================
* Electrothermal Model for GPU Power Components
* =============================================================================
* Model:
* - MOSFET junction-to-case: Rth_jc = 1C/W, Cth = 1mJ/K
* - Case-to-heatsink: Rth_cs = 0.5C/W
* - Heatsink-to-ambient: Rth_sa = 10C/W
* - Ambient temperature: 25C
* - Temperature-dependent Rds(on): +0.5%/C
* =============================================================================

.title "Electrothermal Model - GPU Power Stage Thermal Analysis"

* =============================================================================
* PARAMETERS
* =============================================================================
.param T_AMB     = 25           ; Ambient temperature (C)
.param RTH_JC    = 1.0          ; Junction-to-case thermal resistance (C/W)
.param RTH_CS    = 0.5          ; Case-to-heatsink thermal resistance (C/W)
.param RTH_SA    = 10.0         ; Heatsink-to-ambient thermal resistance (C/W)
.param CTH_J     = 1m           ; Junction thermal capacitance (J/K)
.param CTH_C     = 100m         ; Case thermal capacitance (J/K)
.param CTH_H     = 1            ; Heatsink thermal capacitance (J/K)

* Temperature coefficient
.param TC_RDS    = 0.005        ; Rds(on) temp coefficient (1/C)
.param T_REF     = 25           ; Reference temperature for Rds(on) (C)

* Electrical parameters
.param VIN       = 12.0         ; Input voltage (V)
.param VOUT      = 0.85         ; Output voltage (V)
.param IOUT      = 100          ; Output current (A)
.param DUTY      = {VOUT/VIN}   ; Duty cycle
.param RDS_ON_25 = 1.0m         ; Rds(on) at 25C (ohms)
.param FSW       = 600k         ; Switching frequency (Hz)

* =============================================================================
* AMBIENT TEMPERATURE SOURCE
* =============================================================================
* Modeled as voltage source (temperature in Volts = degrees C)
V_TAMB TAMB 0 DC {T_AMB}

* =============================================================================
* THERMAL SUBCIRCUIT - SINGLE MOSFET
* =============================================================================
* Models the thermal chain: Junction -> Case -> Heatsink -> Ambient
* Using electrical analogy: Temperature = Voltage, Heat Flow = Current

.SUBCKT THERMAL_CHAIN TJ TC THS TAMB
* Junction-to-case thermal resistance
RTH1 TJ TC {RTH_JC}

* Junction thermal capacitance (thermal mass)
CTH1 TJ 0 {CTH_J}

* Case-to-heatsink thermal resistance (TIM)
RTH2 TC THS {RTH_CS}

* Case thermal capacitance
CTH2 TC 0 {CTH_C}

* Heatsink-to-ambient thermal resistance
RTH3 THS TAMB {RTH_SA}

* Heatsink thermal capacitance
CTH3 THS 0 {CTH_H}
.ENDS THERMAL_CHAIN

* =============================================================================
* TEMPERATURE-DEPENDENT MOSFET MODEL
* =============================================================================
* MOSFET with Rds(on) that increases with temperature
* Rds(T) = Rds(25) * (1 + TC * (T - 25))

.SUBCKT MOSFET_THERMAL DRAIN GATE SOURCE TJ
* Gate drive
B_GATE DRAIN_INT SOURCE V=V(GATE)>2.5 ? V(DRAIN) : 0

* Temperature-dependent Rds(on)
* Using behavioral resistor: R = Rds_on_25 * (1 + 0.005 * (Tj - 25))
R_DS DRAIN_INT SOURCE R={RDS_ON_25*(1+TC_RDS*(V(TJ)-T_REF))}

* Gate capacitance
CGS GATE SOURCE 1n
CGD GATE DRAIN 500p
CDS DRAIN SOURCE 100p
.ENDS MOSFET_THERMAL

* =============================================================================
* POWER STAGE - ONE PHASE
* =============================================================================
* Models one phase of the 6-phase buck converter

* Input voltage
VIN VIN 0 DC {VIN}

* PWM signal for this phase
B_PWM PWM 0 V=(TIME*FSW-FLOOR(TIME*FSW))<{DUTY} ? 10 : 0

* High-side MOSFET with thermal model
* Power dissipation in HS MOSFET: P = I^2 * Rds * D + switching losses
M_HS VIN PWM HS_SW 0 MOSFET_THERMAL L=1u W=1m
XTH_HS TJ_HS TC_HS THS_HS TAMB THERMAL_CHAIN

* Low-side MOSFET with thermal model
* Power dissipation in LS MOSFET: P = I^2 * Rds * (1-D)
M_LS HS_SW PWM_LS 0 0 MOSFET_THERMAL L=1u W=1m
XTH_LS TJ_LS TC_LS THS_LS TAMB THERMAL_CHAIN

* Complementary PWM for low-side
B_PWM_LS PWM_LS 0 V=V(PWM)<2.5 ? 10 : 0

* Bootstrap diode
D_BOOT VIN BOOT DTHERM
C_BOOT BOOT PWM 100n

* Output inductor
L_OUT HS_SW PHASE_OUT 150n Rser=0.3m

* Output capacitor
C_OUT PHASE_OUT 0 22u Rser=2m

* Load current (portion for one phase)
I_LOAD PHASE_OUT 0 {IOUT/6}

* =============================================================================
* POWER DISSIPATION CALCULATION
* =============================================================================
* High-side conduction losses
B_P_HS P_HS 0 V=(IOUT/6)^2 * RDS_ON_25 * (1+TC_RDS*(V(TJ_HS)-T_REF)) * {DUTY}

* Low-side conduction losses
B_P_LS P_LS 0 V=(IOUT/6)^2 * RDS_ON_25 * (1+TC_RDS*(V(TJ_LS)-T_REF)) * (1-{DUTY})

* Switching losses (approximate)
* P_sw = 0.5 * VIN * IOUT/6 * (tr+tf) * FSW
* Assuming tr=tf=10ns
B_P_SW P_SW 0 V=0.5*{VIN}*(IOUT/6)*20n*{FSW}

* Total power dissipation per MOSFET
B_P_TOTAL_HS P_TOTAL_HS 0 V=V(P_HS)+V(P_SW)/2
B_P_TOTAL_LS P_TOTAL_LS 0 V=V(P_LS)+V(P_SW)/2

* =============================================================================
* THERMAL RUNAWAY DETECTION
* =============================================================================
* Detect if temperature exceeds safe limits (Tj > 150C)

* High-side thermal runaway
B_TRIP_HS TRIP_HS 0 V=V(TJ_HS)>150 ? 5 : 0
R_TRIP_HS TRIP_HS TRIP_HS_L 1
C_TRIP_HS TRIP_HS_L 0 1p
B_TRIP_HS_LATCH TRIP_HS_L 0 V=V(TRIP_HS)>2.5 ? 5 : V(TRIP_HS_L)

* Low-side thermal runaway
B_TRIP_LS TRIP_LS 0 V=V(TJ_LS)>150 ? 5 : 0
R_TRIP_LS TRIP_LS TRIP_LS_L 1
C_TRIP_LS TRIP_LS_L 0 1p
B_TRIP_LS_LATCH TRIP_LS_L 0 V=V(TRIP_LS)>2.5 ? 5 : V(TRIP_LS_L)

* Combined thermal fault
B_THERM_FAULT THERM_FAULT 0 V=V(TRIP_HS_L)>2.5 || V(TRIP_LS_L)>2.5 ? 5 : 0

* Thermal warning (Tj > 125C)
B_THERM_WARN THERM_WARN 0 V=V(TJ_HS)>125 || V(TJ_LS)>125 ? 5 : 0

* =============================================================================
* HEATSINK TEMPERATURE MONITORING
* =============================================================================
* Monitor heatsink temperature for system thermal management

B_THS_MAX THS_MAX 0 V=MAX(V(THS_HS), V(THS_LS))
B_TCASE_MAX TCASE_MAX 0 V=MAX(V(TC_HS), V(TC_LS))
B_TJ_MAX TJ_MAX 0 V=MAX(V(TJ_HS), V(TJ_LS))

* =============================================================================
* THERMAL SHUTDOWN SIMULATION
* =============================================================================
* Simulate rising ambient to test thermal protection
V_TAMB_RISE TAMB_RISE 0 DC {T_AMB} PWL(0 {T_AMB} 100m {T_AMB} 200m 50 300m 50)

* Switch between fixed and rising ambient
B_TAMB_CTRL TAMB_CTRL 0 V=V(TAMB_RISE)

* =============================================================================
* 6-PHASE AGGREGATE THERMAL MODEL
* =============================================================================
* Model all 6 phases with shared heatsink

* Total power on shared heatsink
B_P_TOTAL P_TOTAL 0 V=6*(V(P_TOTAL_HS)+V(P_TOTAL_LS))

* Shared heatsink thermal model
RTH_HS_TOTAL P_TOTAL THS_SHARED {RTH_SA/6}
CTH_HS_TOTAL THS_SHARED 0 {CTH_H*6}
RTH_CS_TOTAL THS_SHARED TAMB {RTH_CS}

* Heatsink temperature with all phases
B_THS_SHARED THS_TEMP 0 V=V(THS_SHARED)

* =============================================================================
* DIODE MODEL WITH THERMAL EFFECTS
* =============================================================================
.MODEL DTHERM D(IS=1e-14 N=1.0 RS=0.1 CJO=100p VJ=0.6 M=0.5 TT=10n
+ EG=1.11 XTI=3.0)

* =============================================================================
* ANALYSIS COMMANDS
* =============================================================================
* Operating point - steady-state temperatures
.OP

* Transient analysis - thermal time constants
* Run 500ms to capture thermal settling
.TRAN 0 500m 0 1u

* DC sweep - vary ambient temperature
.DC V_TAMB 25 100 5

* Save all thermal nodes
.SAVE V(TJ_HS) V(TJ_LS) V(TC_HS) V(TC_LS)
.SAVE V(THS_HS) V(THS_LS) V(TAMB)
.SAVE V(P_HS) V(P_LS) V(P_SW) V(P_TOTAL)
.SAVE V(TRIP_HS_L) V(TRIP_LS_L) V(THERM_FAULT) V(THERM_WARN)
.SAVE V(THS_TEMP) V(TJ_MAX) V(TCASE_MAX)

* =============================================================================
* DESIGN NOTES
* =============================================================================
* Thermal Design:
* - Each phase dissipates ~3W (1.5W HS + 1.5W LS)
* - Total MOSFET dissipation: 6 phases * 3W = 18W
* - With Rth_sa = 10C/W: Theta_ja_heatsink = 10/6 = 1.67C/W
* - Temperature rise: 18W * 1.67 = 30C
* - Tj_max = 25 + 30 + (3W * 1.5C/W) = 25 + 30 + 4.5 = 59.5C
*
* Temperature Coefficient Effects:
* - Rds(on) increases 0.5% per degree C
* - At Tj = 100C: Rds multiplier = 1 + 0.005*(100-25) = 1.375
* - Power dissipation increases, creating positive feedback
* - Can lead to thermal runaway if not properly heatsinked
*
* Thermal Runaway Condition:
* - Occurs when dP/dTj > 1/Rth_ja
* - dP/dTj = I^2 * Rds * TC = (16.7)^2 * 1m * 0.005 = 1.39mW/C
* - 1/Rth_ja = 1/11.5 = 87mW/C
* - Since 1.39mW/C < 87mW/C, thermally stable
*
* Heatsink Requirements:
* - For Tj_max < 125C with T_amb = 50C:
* - Max allowed Rth_ja = (125-50)/18 = 4.17C/W
* - Rth_jc + Rth_cs = 1.5C/W
* - Required Rth_sa = 4.17 - 1.5 = 2.67C/W
* - Need active cooling (fan) or large heatsink
*
* Protection:
* - Thermal warning at Tj = 125C (reduce clock/voltage)
* - Thermal shutdown at Tj = 150C (disable output)
* - Hysteresis prevents oscillation
*
* PCB Thermal Design:
* - Use thermal vias under MOSFETs
* - Connect to internal ground planes
* - Copper pour on top layer for heat spreading
* - Consider phase interleaving for thermal distribution
* =============================================================================

.END
