* =============================================================================
* GDDR6 Memory Power Supply - Single-Phase Buck Converter
* =============================================================================
* Specifications:
*   VIN = 12V, VOUT = 1.2V
*   IOUT = 5A (continuous), IMAX = 7A
*   Switching frequency: 500kHz
*   Inductor: 2.2uH
*   Output capacitors: 22uF x 4
*   Controller: TI TPS54360 (Adaptive On-Time)
* =============================================================================

.title "GDDR6 Memory Buck Converter - 1.2V @ 5A"

* =============================================================================
* PARAMETERS
* =============================================================================
.param VIN      = 12.0         ; Input voltage (V)
.param VOUT     = 1.20         ; Output voltage for GDDR6 (V)
.param IOUT_NOM = 5.0          ; Nominal output current (A)
.param IOUT_MAX = 7.0          ; Maximum output current (A)
.param FSW      = 500k         ; Switching frequency (Hz)
.param DUTY     = {VOUT/VIN}   ; Duty cycle

* Inductor parameters
.param L_VAL    = 2.2u         ; Inductance (H)
.param L_DCR    = 25m          ; DC resistance (ohms)

* Output capacitors
.param COUT     = 22u          ; Capacitance per cap (F)
.param COUT_ESR = 5m           ; ESR per cap (ohms)
.param COUT_NUM = 4             ; Number of output capacitors

* MOSFET parameters (integrated in TPS54360, modeled externally)
.param R_HS    = 80m           ; High-side Rds(on) (ohms)
.param R_LS    = 40m           ; Low-side Rds(on) (ohms)

* Adaptive on-time parameters
.param T_ON    = {DUTY/FSW}    ; On-time (s)
.param T_OFF_MIN = 200n         ; Minimum off-time (s)

* =============================================================================
* INPUT SOURCE AND FILTERING
* =============================================================================
VIN VIN 0 DC {VIN}

* Input bulk capacitance
CIN1 VIN 0 10u IC=12
CIN2 VIN 0 10u IC=12
CIN3 VIN 0 100n IC=12

* Input RC filter for EMI
RIN_FILT VIN VIN_FILT 10m
CIN_FILT VIN_FILT 0 1u

* =============================================================================
* TPS54360 CONTROLLER MODEL - Adaptive On-Time Control
* =============================================================================
* The TPS54360 uses constant on-time control with frequency regulation
* On-time is set by input voltage and output voltage

* Enable pin - active high
VEN EN 0 DC 5

* Feedback network - divide VOUT to 0.8V reference
* Rfb1/Rfb2 = (VOUT/0.8) - 1 = (1.2/0.8) - 1 = 0.5
R_FB1 VOUT FB 10.0k
R_FB2 FB 0 20.0k

* Error comparator (hysteretic for AOT control)
* When FB < 0.8V, turn on high-side
B_ERR COMP_OUT 0 V=V(FB)<0.795 ? 5 : 0

* One-shot timer for on-time generation
* Generates fixed on-time pulse when triggered
B_ONESHOT ONE_SHOT 0 V=V(COMP_OUT)>2.5 ? 5 : 0

* On-time delay element
R_OT1 ONE_SHOT TON_DEL 1k
C_OT1 TON_DEL 0 {T_ON/1k}

* PWM logic - high-side on during one-shot, then low-side
B_PWM PWM_HS 0 V=V(ONE_SHOT)>2.5 ? 5 : 0
B_PWM_LS PWM_LS 0 V=V(ONE_SHOT)<2.5 ? 5 : 0

* =============================================================================
* POWER STAGE
* =============================================================================
* High-side MOSFET (modeled as voltage-controlled resistor)
R_HS_SW VIN_FILT SW {R_HS}
V_HS_DRV SW_DRV HS_GATE DC 0
B_HS_SW SW_DRV VIN_FILT V=V(PWM_HS)>2.5 ? 0 : 100

* Low-side MOSFET (modeled as voltage-controlled resistor)
R_LS_SW SW 0 {R_LS}
V_LS_DRV LS_DRV0 LS_GATE DC 0
B_LS_SW LS_DRV0 0 V=V(PWM_LS)>2.5 ? 0 : 100

* Bootstrap capacitor for high-side driver
C_BOOT BOOT HS_GATE 100n
D_BOOT VIN_FILT BOOT DBOOT

* =============================================================================
* OUTPUT FILTER
* =============================================================================
* Power inductor
L1 SW VOUT_L {L_VAL} Rser={L_DCR}

* Output capacitors (4 x 22uF MLCC)
COUT1 VOUT_L 0 {COUT} Rser={COUT_ESR}
COUT2 VOUT_L 0 {COUT} Rser={COUT_ESR}
COUT3 VOUT_L 0 {COUT} Rser={COUT_ESR}
COUT4 VOUT_L 0 {COUT} Rser={COUT_ESR}

* Additional ceramic for high-frequency decoupling
COUT_HF1 VOUT_L 0 1u Rser=1m
COUT_HF2 VOUT_L 0 1u Rser=1m

* Output node
R_OUT_SENSE VOUT_L VOUT 1m

* =============================================================================
* LOAD
* =============================================================================
* Static load - 5A nominal
I_LOAD DC VOUT 0 {IOUT_NOM}

* Transient load step for testing
* Steps from 1A to 5A to 7A at different times
I_LOAD_TRAN VOUT 0 PWL(
+ 0 0
+ 1m 0
+ 1.01m 1
+ 3m 1
+ 3.01m 5
+ 6m 5
+ 6.01m 7
+ 8m 7
+ 8.01m 2
+ 10m 2
+)

* =============================================================================
* CURRENT LIMIT / OVER-CURRENT PROTECTION
* =============================================================================
* Current sense through inductor DCR or sense resistor
R_ISENSE VOUT_L ISENSE_NODE 10m
B_ISENSE ISENSE 0 V=V(ISENSE_NODE)/0.01

* Current limit comparator (7.5A threshold)
B_ILIM ILIM_FAULT 0 V=V(ISENSE)>7.5 ? 5 : 0

* Foldback current limit
R_ILIM1 ILIM_FAULT ILIM_OUT 1k
C_ILIM ILIM_OUT 0 1n

* =============================================================================
* SOFT-START
* =============================================================================
* Internal soft-start - 2ms ramp
R_SS EN SS_CAP 100k
C_SS SS_CAP 0 10n IC=0

* Soft-start reference voltage ramp
B_SS_REF SS_REF 0 V=0.8*URAMP(V(SS_CAP)/0.8)

* =============================================================================
* BOOTSTRAP DIODE MODEL
* =============================================================================
.MODEL DBOOT D(IS=1e-14 N=1.0 RS=0.5 CJO=50p VJ=0.6 M=0.5 TT=5n)

* =============================================================================
* DIODE MODELS
* =============================================================================
.MODEL DSW D(IS=1e-15 N=1.0 RS=0.01 CJO=1n VJ=0.6 M=0.5 TT=10n)

* =============================================================================
* ANALYSIS COMMANDS
* =============================================================================
* Operating point
.OP

* Transient analysis - 10ms for startup and load transients
.TRAN 0 10m 0 10n UIC

* Save key waveforms
.SAVE V(VOUT) V(VIN) I(VIN) V(FB) V(PWM_HS) I(L1)

* =============================================================================
* DESIGN NOTES
* =============================================================================
* Adaptive On-Time (AOT) Control:
* - On-time is inversely proportional to VIN
* - Switching frequency remains approximately constant
* - No compensation network required (inherently stable)
* - Fast transient response
*
* Inductor Selection:
* - L = 2.2uH selected for ripple current = VOUT*(1-D)/(L*FSW)
* - Delta_I = 1.2*(1-0.1)/(2.2u*500k) = 0.98A (approx 20% of IOUT)
*
* Output Capacitor Selection:
* - 4 x 22uF = 88uF total
* - Target output ripple: < 20mV
* - ESR contribution to ripple: Delta_I * ESR = 1A * 1.25mOhm = 1.25mV
*
* Efficiency Estimate:
* - Conduction loss: IOUT^2 * (D*R_HS + (1-D)*R_LS) = 25*(0.1*0.08 + 0.9*0.04) = 1.1W
* - Switching loss: ~0.5W
* - Inductor loss: IOUT^2 * DCR = 25 * 0.025 = 0.625W
* - Total loss: ~2.2W
* - Efficiency: 6W / (6W + 2.2W) = 73%
* =============================================================================

.END
