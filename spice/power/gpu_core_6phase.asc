* =============================================================================
* GPU Core Power Supply - 6-Phase Interleaved Buck Converter
* =============================================================================
* Specifications:
*   VIN = 12V, VOUT = 0.85V
*   IOUT = 100A (continuous), IMAX = 120A
*   Switching frequency: 600kHz per phase
*   Inductor: 150nH per phase (Vishay IHLP-2525)
*   Output capacitors: 22uF MLCC x 24 (4 per phase)
*   MOSFETs: Infineon BSC010N04LS (high-side), BSC028N06NS (low-side)
*   Controller: TI TPS53681 (D-CAP+ mode)
*   Phase interleaving: 60 degrees offset
* =============================================================================

.title "GPU Core 6-Phase Interleaved Buck Converter - 0.85V @ 100A"

* =============================================================================
* GLOBAL PARAMETERS
* =============================================================================
.param VIN      = 12.0         ; Input voltage from PCIe slot
.param VOUT     = 0.85         ; Target GPU core voltage
.param IOUT_MAX = 120          ; Maximum output current (A)
.param IOUT_NOM = 100          ; Nominal output current (A)
.param FSW      = 600k         ; Switching frequency per phase (Hz)
.param PHASENUM = 6            ; Number of phases
.param DUTY     = {VOUT/VIN}   ; Steady-state duty cycle

* Inductor parameters
.param LPH      = 150n         ; Inductance per phase (H)
.param L_DCR    = 0.3m         ; Inductor DC resistance (ohms)

* Current sense
.param RSENSE   = 10u          ; Current sense resistor (ohms)

* Output capacitors
.param COUT     = 22u          ; Capacitance per capacitor (F)
.param COUT_ESR = 2m           ; ESR per capacitor (ohms)
.param COUT_NUM = 24           ; Total output capacitors

* Soft-start
.param T_SS     = 2m           ; Soft-start time (s)
.param VREF     = 0.6          ; Internal reference voltage (V)

* Type-III compensator frequencies
.param FZ1      = 10k          ; First zero frequency
.param FZ2      = 50k          ; Second zero frequency
.param FP1      = 200k         ; First pole frequency
.param FP2      = 1Meg         ; Second pole frequency

* =============================================================================
* MOSFET MODELS
* =============================================================================
* Infineon BSC010N04LS - High-Side N-Channel MOSFET
* VDS=40V, ID=100A, Rds(on)=1.0mOhm @ Vgs=10V
.MODEL BSC010N04LS NMOS (
+ LEVEL=1
+ VTO=2.5
+ KP=50
+ LAMBDA=0.01
+ RDS=1.0m
+ CGSO=2n
+ CGDO=500p
+ CGBO=100p
+ CBD=500p
+ PB=0.8
+ MJ=0.5
)

* Infineon BSC028N06NS - Low-Side N-Channel MOSFET
* VDS=60V, ID=100A, Rds(on)=2.8mOhm @ Vgs=10V
.MODEL BSC028N06NS NMOS (
+ LEVEL=1
+ VTO=2.2
+ KP=30
+ LAMBDA=0.01
+ RDS=2.8m
+ CGSO=2n
+ CGDO=500p
+ CGBO=100p
+ CBD=500p
+ PB=0.8
+ MJ=0.5
)

* =============================================================================
* VOLTAGE SOURCE - 12V INPUT (PCIe slot + 6-pin connector)
* =============================================================================
VIN VIN 0 DC {VIN}
CIN VIN 0 100u IC=12
RIN_SRC VIN VIN_FILT 0.5m
CIN_FILT VIN_FILT 0 100u

* =============================================================================
* SOFT-START CIRCUIT
* =============================================================================
* Soft-start capacitor generates ramping reference voltage
R_SS1 VIN SS_CAP 100k
C_SS SS_CAP 0 {100n} IC=0
B_SS_REF SS_OUT 0 V=0.85*URAMP(V(SS_CAP)/0.85)
* The soft-start ramps the output voltage from 0 to VOUT over T_SS

* =============================================================================
* PWM GENERATOR SUBCIRCUIT (D-CAP+ Controller Model)
* =============================================================================
* 6-phase interleaved PWM with 60 degree offsets
* Phase 1: 0deg, Phase 2: 60deg, Phase 3: 120deg
* Phase 4: 180deg, Phase 5: 240deg, Phase 6: 300deg

.SUBCKT PWM_GEN PH_OUT FB VREF_INT VIN_SNS EN
* Simplified D-CAP+ controller model using behavioral source
* Generates PWM with duty cycle based on error amplifier output
B_PWM PH_OUT 0 V=URAMP(V(FB)-V(VREF_INT))>0 ? 5 : 0
.ENDS PWM_GEN

* =============================================================================
* ERROR AMPLIFIER / TYPE-III COMPENSATOR
* =============================================================================
* Type-III compensator for voltage mode control
* Provides phase boost for stability

* Feedback network - divide VOUT to match VREF (0.6V)
* Rfb1/Rfb2 ratio = (VOUT/VREF) - 1 = (0.85/0.6) - 1 = 0.417
R_FB1 VOUT FB_NODE 10k
R_FB2 FB_NODE 0 4.17k
C_FB1 FB_NODE 0 {1/(2*3.14159*FZ1*10k)}

* Error amplifier (differential with gain)
B_EA EA_OUT 0 V=100*(V(SS_OUT)-V(FB_NODE))
R_EA EA_OUT EA_INT 1k
C_EA1 EA_INT 0 {1/(2*3.14159*FZ2*1k)}
C_EA2 EA_OUT EA_INT {1/(2*3.14159*FP1*1k)}
R_EA2 EA_INT COMP_OUT 100
C_EA3 COMP_OUT 0 {1/(2*3.14159*FP2*100)}

* =============================================================================
* PHASE 1 - 0 DEGREE OFFSET
* =============================================================================
* PWM generator for phase 1
B_PWM1 PWM1 0 V=(TIME*FSW - FLOOR(TIME*FSW)) < {DUTY} ? 10 : 0

* High-side MOSFET driver
B_HS_DRV1 HS_GATE1 0 V=V(PWM1)>5 ? V(VIN_FILT)+10 : 0

* High-side MOSFET (BSC010N04LS)
M_HS1 VIN_FILT HS_GATE1 SW1 0 BSC010N04LS

* Low-side MOSFET driver (complementary with dead time)
B_LS_DRV1 LS_GATE1 0 V=V(PWM1)>5 ? 0 : 10

* Low-side MOSFET (BSC028N06NS)
M_LS1 SW1 LS_GATE1 0 0 BSC028N06NS

* Bootstrap capacitor
C_BOOT1 BOOT1 HS_GATE1 100n
D_BOOT1 VIN_FILT BOOT1 DBOOT

* Phase inductor
L1 SW1 PHASE1 {LPH} Rser={L_DCR}

* Current sense resistor
RS1 PHASE1 SENSE1 {RSENSE}

* Output capacitors for phase 1 (4 x 22uF)
COUT1A VOUT 0 {COUT} Rser={COUT_ESR}
COUT1B VOUT 0 {COUT} Rser={COUT_ESR}
COUT1C VOUT 0 {COUT} Rser={COUT_ESR}
COUT1D VOUT 0 {COUT} Rser={COUT_ESR}

* =============================================================================
* PHASE 2 - 60 DEGREE OFFSET (1/6 of period)
* =============================================================================
B_PWM2 PWM2 0 V=(TIME*FSW - FLOOR(TIME*FSW) + 1/6) < {DUTY} || (TIME*FSW - FLOOR(TIME*FSW) + 1/6) >= 1 ? 10 : 0

B_HS_DRV2 HS_GATE2 0 V=V(PWM2)>5 ? V(VIN_FILT)+10 : 0
M_HS2 VIN_FILT HS_GATE2 SW2 0 BSC010N04LS

B_LS_DRV2 LS_GATE2 0 V=V(PWM2)>5 ? 0 : 10
M_LS2 SW2 LS_GATE2 0 0 BSC028N06NS

C_BOOT2 BOOT2 HS_GATE2 100n
D_BOOT2 VIN_FILT BOOT2 DBOOT

L2 SW2 PHASE2 {LPH} Rser={L_DCR}
RS2 PHASE2 SENSE2 {RSENSE}

COUT2A VOUT 0 {COUT} Rser={COUT_ESR}
COUT2B VOUT 0 {COUT} Rser={COUT_ESR}
COUT2C VOUT 0 {COUT} Rser={COUT_ESR}
COUT2D VOUT 0 {COUT} Rser={COUT_ESR}

* =============================================================================
* PHASE 3 - 120 DEGREE OFFSET (2/6 of period)
* =============================================================================
B_PWM3 PWM3 0 V=(TIME*FSW - FLOOR(TIME*FSW) + 2/6) < {DUTY} || (TIME*FSW - FLOOR(TIME*FSW) + 2/6) >= 1 ? 10 : 0

B_HS_DRV3 HS_GATE3 0 V=V(PWM3)>5 ? V(VIN_FILT)+10 : 0
M_HS3 VIN_FILT HS_GATE3 SW3 0 BSC010N04LS

B_LS_DRV3 LS_GATE3 0 V=V(PWM3)>5 ? 0 : 10
M_LS3 SW3 LS_GATE3 0 0 BSC028N06NS

C_BOOT3 BOOT3 HS_GATE3 100n
D_BOOT3 VIN_FILT BOOT3 DBOOT

L3 SW3 PHASE3 {LPH} Rser={L_DCR}
RS3 PHASE3 SENSE3 {RSENSE}

COUT3A VOUT 0 {COUT} Rser={COUT_ESR}
COUT3B VOUT 0 {COUT} Rser={COUT_ESR}
COUT3C VOUT 0 {COUT} Rser={COUT_ESR}
COUT3D VOUT 0 {COUT} Rser={COUT_ESR}

* =============================================================================
* PHASE 4 - 180 DEGREE OFFSET (3/6 of period)
* =============================================================================
B_PWM4 PWM4 0 V=(TIME*FSW - FLOOR(TIME*FSW) + 3/6) < {DUTY} || (TIME*FSW - FLOOR(TIME*FSW) + 3/6) >= 1 ? 10 : 0

B_HS_DRV4 HS_GATE4 0 V=V(PWM4)>5 ? V(VIN_FILT)+10 : 0
M_HS4 VIN_FILT HS_GATE4 SW4 0 BSC010N04LS

B_LS_DRV4 LS_GATE4 0 V=V(PWM4)>5 ? 0 : 10
M_LS4 SW4 LS_GATE4 0 0 BSC028N06NS

C_BOOT4 BOOT4 HS_GATE4 100n
D_BOOT4 VIN_FILT BOOT4 DBOOT

L4 SW4 PHASE4 {LPH} Rser={L_DCR}
RS4 PHASE4 SENSE4 {RSENSE}

COUT4A VOUT 0 {COUT} Rser={COUT_ESR}
COUT4B VOUT 0 {COUT} Rser={COUT_ESR}
COUT4C VOUT 0 {COUT} Rser={COUT_ESR}
COUT4D VOUT 0 {COUT} Rser={COUT_ESR}

* =============================================================================
* PHASE 5 - 240 DEGREE OFFSET (4/6 of period)
* =============================================================================
B_PWM5 PWM5 0 V=(TIME*FSW - FLOOR(TIME*FSW) + 4/6) < {DUTY} || (TIME*FSW - FLOOR(TIME*FSW) + 4/6) >= 1 ? 10 : 0

B_HS_DRV5 HS_GATE5 0 V=V(PWM5)>5 ? V(VIN_FILT)+10 : 0
M_HS5 VIN_FILT HS_GATE5 SW5 0 BSC010N04LS

B_LS_DRV5 LS_GATE5 0 V=V(PWM5)>5 ? 0 : 10
M_LS5 SW5 LS_GATE5 0 0 BSC028N06NS

C_BOOT5 BOOT5 HS_GATE5 100n
D_BOOT5 VIN_FILT BOOT5 DBOOT

L5 SW5 PHASE5 {LPH} Rser={L_DCR}
RS5 PHASE5 SENSE5 {RSENSE}

COUT5A VOUT 0 {COUT} Rser={COUT_ESR}
COUT5B VOUT 0 {COUT} Rser={COUT_ESR}
COUT5C VOUT 0 {COUT} Rser={COUT_ESR}
COUT5D VOUT 0 {COUT} Rser={COUT_ESR}

* =============================================================================
* PHASE 6 - 300 DEGREE OFFSET (5/6 of period)
* =============================================================================
B_PWM6 PWM6 0 V=(TIME*FSW - FLOOR(TIME*FSW) + 5/6) < {DUTY} || (TIME*FSW - FLOOR(TIME*FSW) + 5/6) >= 1 ? 10 : 0

B_HS_DRV6 HS_GATE6 0 V=V(PWM6)>5 ? V(VIN_FILT)+10 : 0
M_HS6 VIN_FILT HS_GATE6 SW6 0 BSC010N04LS

B_LS_DRV6 LS_GATE6 0 V=V(PWM6)>5 ? 0 : 10
M_LS6 SW6 LS_GATE6 0 0 BSC028N06NS

C_BOOT6 BOOT6 HS_GATE6 100n
D_BOOT6 VIN_FILT BOOT6 DBOOT

L6 SW6 PHASE6 {LPH} Rser={L_DCR}
RS6 PHASE6 SENSE6 {RSENSE}

COUT6A VOUT 0 {COUT} Rser={COUT_ESR}
COUT6B VOUT 0 {COUT} Rser={COUT_ESR}
COUT6C VOUT 0 {COUT} Rser={COUT_ESR}
COUT6D VOUT 0 {COUT} Rser={COUT_ESR}

* =============================================================================
* COMMON OUTPUT NODE - ALL PHASES CONNECTED
* =============================================================================
* Phase coupling through common output node (already connected above via VOUT)
* Additional bulk capacitance for ripple reduction
COUT_BULK1 VOUT 0 100u Rser=10m
COUT_BULK2 VOUT 0 100u Rser=10m

* Output load - modeled as current source with step for transient analysis
* 100A nominal load with 50A load step for transient testing
I_LOAD VOUT 0 PWL(0 0 1m 0 1.01m {IOUT_NOM/6} 5m {IOUT_NOM/6} 5.01m {IOUT_MAX/6} 10m {IOUT_MAX/6})

* =============================================================================
* CURRENT SENSING AND OVER-CURRENT PROTECTION
* =============================================================================
* Sum all phase currents using current sense resistors
B_ISENSE1 ISENSE1 0 I=V(SENSE1)/{RSENSE}
B_ISENSE2 ISENSE2 0 I=V(SENSE2)/{RSENSE}
B_ISENSE3 ISENSE3 0 I=V(SENSE3)/{RSENSE}
B_ISENSE4 ISENSE4 0 I=V(SENSE4)/{RSENSE}
B_ISENSE5 ISENSE5 0 I=V(SENSE5)/{RSENSE}
B_ISENSE6 ISENSE6 0 I=V(SENSE6)/{RSENSE}

* Total current sum
B_ITOTAL ITOTAL 0 V=V(ISENSE1)+V(ISENSE2)+V(ISENSE3)+V(ISENSE4)+V(ISENSE5)+V(ISENSE6)

* Over-current protection comparator
* Triggers when total current exceeds 120A
B_OCP OCP_FAULT 0 V=V(ITOTAL)>{IOUT_MAX} ? 5 : 0

* OCP latch - once triggered, stays faulted until reset
R_OCP OCP_FAULT OCP_LATCH 1
C_OCP OCP_LATCH 0 1p
B_OCP_LATCH OCP_LATCH 0 V=V(OCP_FAULT)>2.5 ? 5 : V(OCP_LATCH)

* =============================================================================
* BOOTSTRAP DIODE MODEL
* =============================================================================
.MODEL DBOOT D(IS=1e-15 N=1.0 RS=0.1 CJO=100p VJ=0.6 M=0.5 TT=10n)

* =============================================================================
* ANALYSIS COMMANDS
* =============================================================================
* Operating point analysis
.OP

* Transient analysis for startup and load step response
* Run 10ms to capture soft-start and load transient
.TRAN 0 10m 0 1n UIC

* Save all node voltages and selected currents
.SAVE V(VOUT) V(VIN) I(VIN) I(I_LOAD) V(ITOTAL) V(OCP_FAULT)

* =============================================================================
* DESIGN NOTES
* =============================================================================
* Phase Interleaving Benefits:
* - Input current ripple reduced by factor of N (number of phases)
* - Output voltage ripple frequency = N * FSW = 3.6MHz (effective)
* - Reduced input/output capacitor requirements
* - Better thermal distribution across MOSFETs and inductors
*
* D-CAP+ Control:
* - Direct feedback from output with ripple injection
* - Fast transient response without large output capacitance
* - No external compensation required (simplified model here)
*
* Current Sharing:
* - Each phase carries IOUT/N = 100A/6 = 16.7A nominal
* - Current sense resistors (10uOhm) enable current balancing
*
* Efficiency Considerations:
* - Conduction loss per phase: I^2 * Rds(on) = 16.7^2 * 1mOhm = 0.28W (HS)
* - Total conduction loss (6 phases): ~6 * 0.5W = 3W
* - Switching loss at 600kHz: ~2W per phase
* - Estimated efficiency: 85W / (85W + 15W) ~ 85%
*
* Thermal:
* - Power dissipation per phase MOSFET pair: ~3W
* - Total MOSFET dissipation: ~18W
* - Requires heatsink with Rth_sa < 10C/W per phase
* =============================================================================

.END
