* =============================================================================
* Power Sequencer - Multi-Rail Power-Up Sequence Control
* =============================================================================
* Sequence: Vcore (0.85V) -> Vmem (1.2V) -> VIO_1.8V -> VIO_3.3V
* Delay between rails: 2ms
* Ramping: Monotonic rise
* Fault protection: All rails off on any fault
* Implementation: Discrete MOSFET-based with RC delays
* =============================================================================

.title "GPU Board Power Sequencer - 4-Rail Sequence with Fault Protection"

* =============================================================================
* PARAMETERS
* =============================================================================
.param T_DELAY  = 2m           ; Delay between rails (s)
.param T_RAMP   = 1m           ; Ramp time per rail (s)
.param VTH_ON   = 0.9          ; Power-good threshold (% of target)
.param VTH_OFF  = 0.8          ; Power-good release threshold (%)

* =============================================================================
* INPUTS
* =============================================================================
* System input - 12V from PCIe slot
VIN_SYS SYS_12V 0 DC 12

* Enable signal from system
VEN_SYS EN_SYS 0 DC 5

* Input capacitance
CIN_SYS SYS_12V 0 10u

* =============================================================================
* SEQUENCER CONTROL CIRCUIT
* =============================================================================
* The sequencer uses RC delay chains to generate sequential enable signals
* Each stage waits for the previous rail to reach power-good threshold

* Stage 1: Vcore (0.85V) enable - immediate on EN_SYS
* Enable passes through with minimal delay
R_EN1 EN_SYS EN_VCORE 1k
C_EN1 EN_VCORE 0 100p

* Stage 2: Vmem (1.2V) enable - delayed by T_DELAY after Vcore PG
R_EN2 VCORE_PG EN_VMEM 100k
C_EN2 EN_VMEM 0 {T_DELAY/100k}

* Stage 3: VIO_1.8V enable - delayed by T_DELAY after Vmem PG
R_EN3 VMEM_PG EN_VIO18 100k
C_EN3 EN_VIO18 0 {T_DELAY/100k}

* Stage 4: VIO_3.3V enable - delayed by T_DELAY after VIO_1.8V PG
R_EN4 VIO18_PG EN_VIO33 100k
C_EN4 EN_VIO33 0 {T_DELAY/100k}

* =============================================================================
* RAIL 1: VCORE (0.85V) - GPU CORE BUCK CONVERTER ENABLE
* =============================================================================
* Simplified model of 6-phase buck converter
* Controlled by EN_VCORE signal

* Input to Vcore regulator
RVIN1 SYS_12V VIN_VCORE 10m
CVIN1 VIN_VCORE 0 100u

* Vcore regulator model (simplified buck)
B_VCORE_REG VCORE_SW 0 V=V(EN_VCORE)>2.5 ? 12 : 0
LV_CORE VCORE_SW VCORE_OUT 1u Rser=10m

* Output filter
CV_CORE1 VCORE_OUT 0 100u Rser=5m
CV_CORE2 VCORE_OUT 0 22u Rser=2m
CV_CORE3 VCORE_OUT 0 22u Rser=2m

* Load
I_VCORE VCORE_OUT 0 100

* Feedback and voltage division
R_VCORE_FB1 VCORE_OUT VCORE_FB 8.5k
R_VCORE_FB2 VCORE_FB 0 10k

* Power-good comparator for Vcore (0.85V target, PG at 90%)
B_VCORE_PG VCORE_PG 0 V=V(VCORE_OUT)>(0.85*VTH_ON) ? 5 : 0

* Soft-start ramp
R_SS_CORE EN_VCORE SS_CORE 100k
C_SS_CORE SS_CORE 0 {T_RAMP/100k}
B_VCORE_RAMP VCORE_OUT_RAMP 0 V=0.85*URAMP(V(SS_CORE)/0.85)

* =============================================================================
* RAIL 2: VMEM (1.2V) - GDDR6 MEMORY BUCK CONVERTER ENABLE
* =============================================================================
* Simplified model of single-phase buck converter

RVIN2 SYS_12V VIN_VMEM 10m
CVIN2 VIN_VMEM 0 22u

* Regulator model
B_VMEM_REG VMEM_SW 0 V=V(EN_VMEM)>2.5 ? 12 : 0
LV_MEM VMEM_SW VMEM_OUT 2.2u Rser=25m

* Output filter
CV_MEM1 VMEM_OUT 0 22u Rser=5m
CV_MEM2 VMEM_OUT 0 22u Rser=5m
CV_MEM3 VMEM_OUT 0 22u Rser=5m
CV_MEM4 VMEM_OUT 0 22u Rser=5m

* Load
I_VMEM VMEM_OUT 0 5

* Power-good comparator for Vmem (1.2V target)
B_VMEM_PG VMEM_PG 0 V=V(VMEM_OUT)>(1.2*VTH_ON) ? 5 : 0

* Soft-start ramp
R_SS_MEM EN_VMEM SS_MEM 100k
C_SS_MEM SS_MEM 0 {T_RAMP/100k}
B_VMEM_RAMP VMEM_OUT_RAMP 0 V=1.2*URAMP(V(SS_MEM)/1.2)

* =============================================================================
* RAIL 3: VIO_1.8V - LDO ENABLE
* =============================================================================
* LDO regulator for I/O

RVIN3 VIO33_OUT VIN_VIO18 50m
CVIN3 VIN_VIO18 0 1u

* LDO model (simplified)
B_VIO18_REG VIO18_OUT 0 V=V(EN_VIO18)>2.5 ? 1.8 : 0

* Output capacitor
CV_IO18 VIO18_OUT 0 10u Rser=5m
CV_IO18_HF VIO18_OUT 0 100n

* Load
I_VIO18 VIO18_OUT 0 2

* Power-good comparator
B_VIO18_PG VIO18_PG 0 V=V(VIO18_OUT)>(1.8*VTH_ON) ? 5 : 0

* Soft-start ramp
R_SS_18 EN_VIO18 SS_18 100k
C_SS_18 SS_18 0 {T_RAMP/100k}
B_VIO18_RAMP VIO18_OUT_RAMP 0 V=1.8*URAMP(V(SS_18)/1.8)

* =============================================================================
* RAIL 4: VIO_3.3V - LDO ENABLE
* =============================================================================
* LDO regulator for I/O

RVIN4 SYS_12V VIN_VIO33 10m
CVIN4 VIN_VIO33 0 10u

* Pre-regulator buck (5V output)
B_VIO33_PRE VIO33_PRE_SW 0 V=V(EN_VIO33)>2.5 ? 12 : 0
L_PRE_33 VIO33_PRE_SW VIO33_INT 4.7u Rser=50m
C_PRE_33 VIO33_INT 0 22u Rser=5m

* 3.3V LDO from 5V pre-regulator
B_VIO33_REG VIO33_OUT 0 V=V(EN_VIO33)>2.5 ? 3.3 : 0

* Output capacitor
CV_IO33 VIO33_OUT 0 10u Rser=5m
CV_IO33_HF VIO33_OUT 0 100n

* Load
I_VIO33 VIO33_OUT 0 1

* Power-good comparator
B_VIO33_PG VIO33_PG 0 V=V(VIO33_OUT)>(3.3*VTH_ON) ? 5 : 0

* Soft-start ramp
R_SS_33 EN_VIO33 SS_33 100k
C_SS_33 SS_33 0 {T_RAMP/100k}
B_VIO33_RAMP VIO33_OUT_RAMP 0 V=3.3*URAMP(V(SS_33)/3.3)

* =============================================================================
* FAULT DETECTION AND PROTECTION
* =============================================================================
* Monitor all rails for undervoltage faults

* Undervoltage fault comparators
B_UV_VCORE UV_VCORE 0 V=V(VCORE_OUT)<(0.85*VTH_OFF) && V(EN_VCORE)>2.5 ? 5 : 0
B_UV_VMEM UV_VMEM 0 V=V(VMEM_OUT)<(1.2*VTH_OFF) && V(EN_VMEM)>2.5 ? 5 : 0
B_UV_VIO18 UV_VIO18 0 V=V(VIO18_OUT)<(1.8*VTH_OFF) && V(EN_VIO18)>2.5 ? 5 : 0
B_UV_VIO33 UV_VIO33 0 V=V(VIO33_OUT)<(3.3*VTH_OFF) && V(EN_VIO33)>2.5 ? 5 : 0

* Combined fault signal - OR of all faults
B_FAULT FAULT 0 V=V(UV_VCORE)>2.5 || V(UV_VMEM)>2.5 || V(UV_VIO18)>2.5 || V(UV_VIO33)>2.5 ? 5 : 0

* Fault latch - once triggered, stays faulted
R_FAULT FAULT FAULT_LATCH 1
C_FAULT FAULT_LATCH 0 1p
B_FAULT_LATCH FAULT_LATCH 0 V=V(FAULT)>2.5 ? 5 : V(FAULT_LATCH)

* =============================================================================
* FAULT SHUTDOWN CIRCUIT
* =============================================================================
* On fault, disable all rails by pulling enable signals low

* Disable all enables when fault is active
B_DIS_VCORE DIS_VCORE 0 V=V(FAULT_LATCH)>2.5 ? 0 : V(EN_VCORE)
B_DIS_VMEM DIS_VMEM 0 V=V(FAULT_LATCH)>2.5 ? 0 : V(EN_VMEM)
B_DIS_VIO18 DIS_VIO18 0 V=V(FAULT_LATCH)>2.5 ? 0 : V(EN_VIO18)
B_DIS_VIO33 DIS_VIO33 0 V=V(FAULT_LATCH)>2.5 ? 0 : V(EN_VIO33)

* =============================================================================
* SEQUENCING STATUS INDICATORS
* =============================================================================
* System ready signal - all rails powered and good
B_SYS_RDY SYS_RDY 0 V=V(VCORE_PG)>2.5 && V(VMEM_PG)>2.5 && V(VIO18_PG)>2.5 && V(VIO33_PG)>2.5 && V(FAULT_LATCH)<2.5 ? 5 : 0

* Sequencing complete indicator
R_SEQ_COMP VCORE_PG SEQ_COMP 10k
C_SEQ_COMP SEQ_COMP 0 1n
B_SEQ_DONE SEQ_DONE 0 V=V(SEQ_COMP)>2.5 ? 5 : 0

* =============================================================================
* MANUAL RESET
* =============================================================================
* Reset button/input to clear fault latch
VRESET RESET 0 DC 0 PWL(0 0 20m 0 20.01m 5 20.02m 0)

* Reset circuit
R_RST RESET RST_INT 1k
C_RST RST_INT 0 1n
B_RST FAULT_LATCH 0 V=V(RST_INT)>2.5 ? 0 : V(FAULT_LATCH)

* =============================================================================
* ANALYSIS COMMANDS
* =============================================================================
* Operating point
.OP

* Transient analysis - 25ms to capture full sequencing
.TRAN 0 25m 0 1u UIC

* Save all rail voltages and control signals
.SAVE V(VCORE_OUT) V(VMEM_OUT) V(VIO18_OUT) V(VIO33_OUT)
.SAVE V(EN_VCORE) V(EN_VMEM) V(EN_VIO18) V(EN_VIO33)
.SAVE V(VCORE_PG) V(VMEM_PG) V(VIO18_PG) V(VIO33_PG)
.SAVE V(FAULT) V(FAULT_LATCH) V(SYS_RDY)

* =============================================================================
* DESIGN NOTES
* =============================================================================
* Sequencing Requirements:
* - GPU core must be stable before memory powers up
* - Memory must be stable before I/O rails
* - I/O 1.8V before 3.3V to prevent latch-up
* - 2ms delay ensures each rail reaches regulation
*
* Fault Protection:
* - Any undervoltage fault triggers shutdown of ALL rails
* - Prevents damage from partial power conditions
* - Fault latch requires manual reset or power cycle
*
* Monotonic Rise:
* - Each rail has soft-start ramp to prevent inrush current
* - Prevents voltage overshoot and droop during startup
*
* Power-Good Thresholds:
* - Power-good asserted at 90% of target voltage
* - Undervoltage fault at 80% of target voltage
* - 10% hysteresis prevents chatter
*
* Reset:
* - Manual reset clears fault latch
* - System re-sequences from beginning
* - Reset pulse must be >1ms wide
*
* Alternative Implementation:
* - LTC2937 programmable sequencer provides more flexibility
* - Digital interface for configuration
* - EEPROM storage for sequence parameters
* - More precise timing control
* =============================================================================

.END
