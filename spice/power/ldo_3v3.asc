* =============================================================================
* 3.3V I/O LDO Regulator - TI TPS7A8400
* =============================================================================
* Specifications:
*   VIN = 5V or 12V (via pre-regulator)
*   VOUT = 3.3V
*   IOUT = 1A
*   Dropout: 200mV max
*   Output capacitor: 10uF ceramic
*   LDO: TI TPS7A8400
* =============================================================================

.title "3.3V I/O LDO Regulator - TPS7A8400 - 3.3V @ 1A"

* =============================================================================
* PARAMETERS
* =============================================================================
.param VIN      = 5.00          ; Input voltage from pre-regulator (V)
.param VOUT     = 3.30          ; Output voltage (V)
.param IOUT_NOM = 1.0           ; Nominal output current (A)
.param IOUT_MAX = 1.5           ; Maximum output current (A)
.param VDO_MAX  = 0.20          ; Maximum dropout voltage (V)

* Reference voltage
.param VREF     = 0.80          ; Internal bandgap reference (V)

* Output capacitor
.param COUT     = 10u           ; Output capacitance (F)
.param COUT_ESR = 5m            ; Output capacitor ESR (ohms)

* =============================================================================
* INPUT SOURCE
* =============================================================================
* 5V input from pre-regulator (e.g., 12V to 5V buck)
VIN VIN 0 DC {VIN}

* Input decoupling capacitors
CIN1 VIN 0 1u
CIN2 VIN 0 100n
CIN3 VIN 0 10n

* Input source resistance
RIN_SRC VIN VIN_INT 50m

* =============================================================================
* PRE-REGULATOR (Optional - 12V to 5V Buck)
* =============================================================================
* For systems where 5V is not available, a pre-regulator is used
* This model represents an efficient buck converter generating 5V from 12V
*
* Pre-regulator input
VIN_12V VIN_12V 0 DC 12

* Pre-regulator model (simplified)
R_PRE_IN VIN_12V VIN_PRE 10m
L_PRE VIN_PRE SW_PRE 4.7u Rser=50m
M_PRE_HS VIN_12V HS_GATE_PRE SW_PRE 0 NMOS_PRE
M_PRE_LS SW_PRE LS_GATE_PRE 0 0 NMOS_PRE

* Pre-regulator control
B_PRE_CTRL HS_GATE_PRE 0 V=(TIME*300k-FLOOR(TIME*300k))<(5/12)?10:0
B_PRE_CTRL_LS LS_GATE_PRE 0 V=V(HS_GATE_PRE)<5?10:0

* Pre-regulator output filter
C_PRE1 SW_PRE VIN 22u Rser=5m
C_PRE2 SW_PRE VIN 22u Rser=5m

* Pre-regulator MOSFET model
.MODEL NMOS_PRE NMOS(VTO=2 KP=20 RDS=50m CGSO=1n CGDO=500p)

* =============================================================================
* TPS7A8400 LDO MODEL
* =============================================================================
* Enable pin
VEN EN 0 DC 5

* Bandgap reference
VREF_BG VREF_NODE 0 DC {VREF}

* Error amplifier (transconductance type)
G_EA VIN_INT EA_OUT VREF_NODE FB 200u

* Compensation network
C_EA EA_OUT 0 10p
R_EA EA_OUT EA_INT 1Meg
C_EA2 EA_INT 0 1p

* Feedback divider
* VOUT = VREF * (1 + R1/R2)
* 3.3 = 0.8 * (1 + R1/R2) -> R1/R2 = 3.125
R_FB1 VOUT FB 31.25k
R_FB2 FB 0 10k

* Pass element (PMOS LDO)
G_PASS VIN_INT VOUT_INT EA_OUT 0 10
R_PASS VOUT_INT VOUT_DYN 100m

* =============================================================================
* OUTPUT STAGE
* =============================================================================
* Main output capacitor
COUT VOUT_DYN 0 {COUT} Rser={COUT_ESR}

* Additional decoupling
COUT2 VOUT_DYN 0 1u Rser=2m
COUT3 VOUT_DYN 0 100n Rser=10m
COUT4 VOUT_DYN 0 10n Rser=50m

* Output connection
R_OUT_SENSE VOUT_DYN VOUT 1m

* =============================================================================
* LOAD
* =============================================================================
* Static load - 1A nominal
I_LOAD DC VOUT 0 {IOUT_NOM}

* Dynamic load for transient testing
I_LOAD_TRAN VOUT 0 PWL(
+ 0 0
+ 500u 0
+ 510u 0.2
+ 2m 0.2
+ 2.01m 1.0
+ 5m 1.0
+ 5.01m 0.1
+ 8m 0.1
+ 8.01m 1.0
+ 10m 1.0
+)

* =============================================================================
* CURRENT LIMIT
* =============================================================================
* Internal current limit
B_ILIM ILIM 0 V=I(VIN)>{IOUT_MAX} ? 5 : 0

* =============================================================================
* POWER GOOD INDICATOR
* =============================================================================
* Power good asserted when VOUT within 90-110% of target
B_PG PG 0 V=V(VOUT)>(VOUT*0.9) && V(VOUT)<(VOUT*1.1) ? 5 : 0

* =============================================================================
* ANALYSIS COMMANDS
* =============================================================================
* Operating point
.OP

* Transient analysis
.TRAN 0 10m 0 1n UIC

* AC analysis for stability check
.AC DEC 100 1 10Meg

* Save key waveforms
.SAVE V(VOUT) V(VIN) I(VIN) V(FB) V(PG) I(I_LOAD)

* =============================================================================
* DESIGN NOTES
* =============================================================================
* Power Dissipation:
* - Pdiss = (VIN - VOUT) * IOUT = (5.0 - 3.3) * 1 = 1.7W
* - With Rth_ja = 35C/W: dT = 1.7 * 35 = 59.5C
* - Tj = 25 + 59.5 = 84.5C (within spec)
*
* Dropout Analysis:
* - VIN_min = 5.0V, VOUT = 3.3V, dropout available = 1.7V
* - Required dropout max = 200mV
* - Headroom = 1.5V (very comfortable)
*
* Pre-Regulator Option:
* - If only 12V available, add 12V-to-5V buck pre-regulator
* - Pre-regulator efficiency: ~90%
* - Total efficiency: 0.90 * (3.3/5.0) = 59.4%
* - Alternative: Direct 12V-to-3.3V LDO (worse efficiency)
*
* Stability:
* - 10uF ceramic output capacitor ensures stability
* - Low ESR ceramic caps require internal compensation
* - TPS7A8400 has built-in compensation for ceramic outputs
*
* Use Cases:
* - 3.3V powers: PCIe sideband signals, EEPROM, configuration logic
* - Also serves as input to 1.8V LDO
* =============================================================================

.END
